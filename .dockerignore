# Everything here is either rebuilt inside the image, environment-specific, or has no
# business in a production artefact. Note what is deliberately NOT excluded:
# .env.example (the assets stage boots artisan against a throwaway copy of it) and
# .npmrc (it sets ignore-scripts=true, which the pinned native binaries depend on).

.git
.gitattributes
.gitignore

node_modules
vendor
public/build
public/hot
public/storage
public/fonts-manifest.dev.json
bootstrap/ssr
bootstrap/cache/*.php

# Generated by wayfinder during the asset build, never committed.
resources/js/actions
resources/js/routes
resources/js/wayfinder

storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/pail
storage/*.key

# Everything a developer has actually summarised. CI builds from a clean checkout so the
# published image was never affected, but a local `docker build` would otherwise copy your
# own cover images into it. The whole subtree rather than the three known directories,
# because livewire-tmp, a stray export or a loose file sitting directly in storage/app
# would each have slipped past a narrower list. The Dockerfile creates what it needs.
storage/app/*

.env
.env.*
!.env.example

# Not needed at runtime, and keeping them out means editing a test or a workflow
# does not invalidate the vendor layer.
tests
phpunit.xml
.phpunit.cache
.phpunit.result.cache
rector.php
phpstan.neon
pint.json
.pint.cache

.github
.claude
.agents
.junie
.mcp.json
boost.json
opencode.json
AGENTS.md
CLAUDE.md
README.md

Dockerfile
.dockerignore
compose.yml

.editorconfig
.prettierrc
.prettierignore
eslint.config.js
.idea
.vscode
.zed
.fleet
.nova
.DS_Store

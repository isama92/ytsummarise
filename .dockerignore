# Everything here is either rebuilt inside the image, environment-specific, or has no
# business in a production artefact. Note what is deliberately NOT excluded:
# .env.example (the assets stage boots artisan against a throwaway copy of it) and
# .npmrc (it sets ignore-scripts=true, which the pinned native binaries depend on).

.git
.gitattributes
.gitignore

node_modules
vendor
public/build
public/hot
public/storage
public/fonts-manifest.dev.json
bootstrap/ssr
bootstrap/cache/*.php

# Generated by wayfinder during the asset build, never committed.
resources/js/actions
resources/js/routes
resources/js/wayfinder

storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/pail
storage/*.key

# Everything a developer has actually summarised. CI builds from a clean checkout so the
# published image was never affected, but the README documents building locally for a
# different uid - and without this, `docker build` copies your own cover images into it.
# The Dockerfile creates these three directories itself rather than relying on the copy.
storage/app/private/*
storage/app/public/*
storage/app/video-covers/*

.env
.env.*
!.env.example

# Not needed at runtime, and keeping them out means editing a test or a workflow
# does not invalidate the vendor layer.
tests
phpunit.xml
.phpunit.cache
.phpunit.result.cache
rector.php
phpstan.neon
pint.json
.pint.cache

.github
.claude
.agents
.junie
.mcp.json
boost.json
opencode.json
AGENTS.md
CLAUDE.md
README.md

Dockerfile
.dockerignore
compose.yml

.editorconfig
.prettierrc
.prettierignore
eslint.config.js
.idea
.vscode
.zed
.fleet
.nova
.DS_Store

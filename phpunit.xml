<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="AUTH_ENABLED" value="true"/>
        <env name="AUTHENTIK_NAME" value="Authentik"/>
        <env name="AUTHENTIK_BASE_URL" value="https://authentik.test"/>
        <env name="AUTHENTIK_CLIENT_ID" value="test-client-id"/>
        <env name="AUTHENTIK_CLIENT_SECRET" value="test-client-secret"/>
        <env name="AUTHENTIK_REDIRECT_URI" value="http://localhost/auth/callback"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <!-- Pinned because SummariseVideoTest asserts the default connection is left at
             Laravel's 90. Unset, a developer's own .env would flow into that assertion. -->
        <env name="DB_QUEUE_RETRY_AFTER" value="90"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- A fake key, so the suite runs the fuller configuration by default and never a
             developer's real one. Whoever wants the keyless path says so, with
             withoutYouTubeKey() - see tests/Pest.php.

             Two elements' worth of care, because an api key is the one value here somebody
             plausibly exports from a shell profile rather than writing into .env:

             <env> alone covers .env only. Without force, phpunit skips any variable already in
             the environment. With force it sets putenv and $_ENV - but not $_SERVER, and
             phpdotenv reads ServerConstAdapter before EnvConstAdapter, so an exported key still
             wins. <server> is what closes that, and it is applied unconditionally. Both are
             kept: <server> is what env() reads, <env> is what anything calling getenv() directly
             would read. LookupVideoTest asserts the value that arrives, so a pin that stops
             working fails a test rather than quietly running against somebody's real key. -->
        <server name="YOUTUBE_API_KEY" value="test-api-key"/>
        <env name="YOUTUBE_API_KEY" value="test-api-key" force="true"/>
    </php>
</phpunit>

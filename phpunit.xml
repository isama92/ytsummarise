<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!--
            Registered so the arch rules run on every `php artisan test` and in ci:check.
            Without a testsuite of its own the directory is only reached by naming it on the
            command line, which means a rule can be broken for weeks and nothing says so.
        -->
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="AUTH_ENABLED" value="true"/>
        <env name="AUTHENTIK_NAME" value="Authentik"/>
        <env name="AUTHENTIK_BASE_URL" value="https://authentik.test"/>
        <env name="AUTHENTIK_CLIENT_ID" value="test-client-id"/>
        <env name="AUTHENTIK_CLIENT_SECRET" value="test-client-secret"/>
        <env name="AUTHENTIK_REDIRECT_URI" value="http://localhost/auth/callback"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <!-- Pinned because SummariseVideoTest asserts the default connection is left at
             Laravel's 90. Unset, a developer's own .env would flow into that assertion. -->
        <env name="REDIS_QUEUE_RETRY_AFTER" value="90"/>
        <!-- Nowhere, on purpose. The suite runs on array cache, array sessions and a sync
             queue, so nothing here should ever open a Redis connection - and a test that
             starts to should say so by failing to connect, rather than quietly succeeding
             against whatever a developer happens to have running on 6379 and then failing
             on a machine that has nothing.

             Both elements for the reason the api key below spells out: <env force> alone
             is defeated by an exported REDIS_HOST, because phpdotenv reads
             ServerConstAdapter before EnvConstAdapter. -->
        <server name="REDIS_HOST" value="redis.invalid"/>
        <env name="REDIS_HOST" value="redis.invalid" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- A fake key, so the suite runs the fuller configuration by default and never a
             developer's real one. Whoever wants the keyless path says so, with
             withoutYouTubeKey() - see tests/Pest.php.

             Two elements' worth of care, because an api key is the one value here somebody
             plausibly exports from a shell profile rather than writing into .env:

             <env> alone covers .env only. Without force, phpunit skips any variable already in
             the environment. With force it sets putenv and $_ENV - but not $_SERVER, and
             phpdotenv reads ServerConstAdapter before EnvConstAdapter, so an exported key still
             wins. <server> is what closes that, and it is applied unconditionally. Both are
             kept: <server> is what env() reads, <env> is what anything calling getenv() directly
             would read. LookupVideoTest asserts the value that arrives, so a pin that stops
             working fails a test rather than quietly running against somebody's real key. -->
        <server name="YOUTUBE_API_KEY" value="test-api-key"/>
        <env name="YOUTUBE_API_KEY" value="test-api-key" force="true"/>
        <!-- The same care for the same reason. A developer with a working provider in their
             own .env would otherwise have the suite resolve it, and the AI SDK reads its
             credentials when a provider is first resolved rather than when a prompt is sent -
             so a missing fake would not fail loudly, it would quietly configure the real
             thing and wait for something to leak past a fake.

             Nothing here is ever sent: every test fakes the agents. These exist so that what
             is configured during a test run is unambiguously not anybody's endpoint, and so
             CheckAiProviderTest has known values to assert it reports. -->
        <server name="AI_PROVIDER" value="openai-compatible"/>
        <env name="AI_PROVIDER" value="openai-compatible" force="true"/>
        <server name="OPENAI_COMPATIBLE_URL" value="https://ai.test/api"/>
        <env name="OPENAI_COMPATIBLE_URL" value="https://ai.test/api" force="true"/>
        <server name="OPENAI_COMPATIBLE_API_KEY" value="test-ai-key"/>
        <env name="OPENAI_COMPATIBLE_API_KEY" value="test-ai-key" force="true"/>
        <server name="OPENAI_COMPATIBLE_MODEL" value="test-model"/>
        <env name="OPENAI_COMPATIBLE_MODEL" value="test-model" force="true"/>
        <!-- Pinned so no test can reach a real binary. FetchTranscript fakes the process, and
             a name that is obviously not yt-dlp turns a forgotten fake into a failure that
             says so rather than into a real call to YouTube from CI. -->
        <server name="YT_DLP_BINARY" value="test-yt-dlp"/>
        <env name="YT_DLP_BINARY" value="test-yt-dlp" force="true"/>
    </php>
</phpunit>

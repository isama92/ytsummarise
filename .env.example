APP_NAME=ytsummarise
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ytsummarise
DB_USERNAME=ytsummarise
DB_PASSWORD=secret

# Set to false to skip signing in entirely and use the first user in the
# database, creating one through a setup form when the table is empty.
AUTH_ENABLED=true

AUTHENTIK_NAME=Authentik
AUTHENTIK_BASE_URL=https://authentik.example.com
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI="${APP_URL}/auth/callback"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# How long the work itself gets, in seconds, counted from when a worker starts it
# and never from when it was asked for. Also the lifetime of the lock that lets a
# second request join a job already running, and how long after starting a summary
# is written off. The queue's own retry_after follows this one, so there is nothing
# else to change alongside it.
SUMMARY_TIMEOUT=1800

# How long a summary may wait for a worker to start it at all, in seconds, before
# it is written off. A backstop for a queue that is not running rather than one that
# is busy: waiting is ordinary, so a waiting summary is queued again until this.
SUMMARY_ABANDON_AFTER=86400

# How long a summary is left alone, in seconds, after being queued again. Only the
# second requeue onwards: the first is always prompt, so a job lost with its queue
# is replaced within the hour. This is what stops an outage leaving every waiting
# summary with a day of hourly duplicates for the workers to drain on their return.
SUMMARY_REQUEUE_AFTER=21600

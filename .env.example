APP_NAME=ytsummarise
APP_ENV=local
# Required, and empty is not a usable default: `php artisan key:generate` fills it in
# locally, and in production it is generated once by hand and kept. See the README.
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=redis

# PHP_CLI_SERVER_WORKERS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ytsummarise
DB_USERNAME=ytsummarise
DB_PASSWORD=secret

# Set to false to skip signing in entirely and use the first user in the
# database, creating one through a setup form when the table is empty.
AUTH_ENABLED=true

AUTHENTIK_NAME=Authentik
AUTHENTIK_BASE_URL=https://authentik.example.com
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI="${APP_URL}/auth/callback"

# Redis carries the queue, Horizon's bookkeeping, the sessions and the cache. Locally that
# means a second throwaway container alongside Postgres - see the top of compose.yml - and in
# the compose stack it is a service named `redis`, which is why the stack pins REDIS_HOST
# itself rather than trusting whatever a copied .env says.
#
# Two databases, not one. `cache:clear` is a FLUSHDB, so the cache gets database 1 to itself
# and everything that must survive being cleared stays on database 0. config/database.php has
# the longer version.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
# Which Redis connection holds the sessions. Set explicitly, though it changes nothing: the
# redis session driver borrows the redis CACHE store and then re-points it at this value, and
# leaving it empty resolves to `default` anyway. Written down because "sessions are not in the
# cache database" is the reason `cache:clear` cannot sign everybody out, and that is worth
# being deliberate rather than lucky.
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# How long the work itself gets, in seconds, counted from when a worker starts it
# and never from when it was asked for. Also the lifetime of the lock that drops
# the second of two attempts started for one video in the same moment. The queue's
# own retry_after follows this one, so there is nothing else to change alongside it.
#
# A floor rather than the value. What the job actually gets is whichever is larger:
# this, or what the steps inside it are between them allowed to take - two transcript
# steps and three prompts, plus a minute. Raising SUMMARY_MODEL_TIMEOUT therefore
# raises this too, rather than being quietly reduced to fit inside it.
SUMMARY_TIMEOUT=3600

# How long a summary may stay pending, in seconds, before it is given up on and
# marked failed. Measured from when the attempt was asked for, so a retry starts it
# again. Nothing is queued again as a result: the page says it did not work and
# offers to try once more, and it is a person who decides to.
#
# Raised to twice SUMMARY_TIMEOUT if set below it, silently. The two are timed from
# different moments - this from when the attempt was asked for, the other from when
# the work began - so anything less gives up on attempts whose work is still running.
SUMMARY_STALE_AFTER=21600

# How long one prompt gets, in seconds. Three of them run for a video that is not in
# English, so this is not the budget for the whole job - SUMMARY_TIMEOUT is. It exists
# because the AI SDK's own default is sixty seconds, which is nowhere near enough for a
# local model working through an hour of transcript.
#
# Not capped. Raising this raises the job's own timeout to match rather than being quietly
# reduced to fit inside it, so a prompt can never be the thing still waiting when the worker
# gives up on the job around it.
SUMMARY_MODEL_TIMEOUT=600

# How long yt-dlp gets to answer about a video, in seconds, and separately how long the
# caption track it names gets to arrive. A ceiling for a yt-dlp that has hung rather than a
# target: both are small requests and neither should come close to it.
SUMMARY_TRANSCRIPT_TIMEOUT=120

# How many days a summary is kept before `summaries:prune` deletes it, counted from
# when it was last asked for. So the window is "nobody has asked for this in a week"
# rather than "this is a week old", and asking for a video again renews it. The
# command is scheduled daily.
#
# This is about the transcript stored beside the summary rather than the summary: it
# is a recording of somebody speaking, written down, kept by us, and nobody asked
# them. Keeping it indefinitely because there was never a reason to delete it is the
# storage limitation the AVG is about.
#
# Set to 0 to switch it off and keep everything. Worth knowing what that chooses:
# holding other people's speech with no end date, which wants a reason of its own.
#
# Deleting a summary is less destructive than it sounds - asking for the same video
# again produces a new one, at the cost of making it again.
SUMMARY_RETENTION_DAYS=7

# Where yt-dlp is. Left as the bare name it is looked up on PATH, which is where both a
# development machine and the published image have it; somewhere it is installed off PATH
# takes an absolute path here. Summarising needs it: the transcript is what gets summarised,
# and nothing else in the application can fetch one.
YT_DLP_BINARY=yt-dlp

# Which provider in config/ai.php does the summarising. Any of the twelve there that
# generate text; cohere, jina and voyageai do embeddings and reranking, eleven does audio,
# and naming one of those fails at the first prompt rather than at startup.
#
# The agents name neither a provider nor a model, so this and the provider's own configured
# model are the whole of the choice, and moving between them changes no code.
AI_PROVIDER=openai-compatible

# Credentials for the openai-compatible provider: anything speaking OpenAI's chat
# completions dialect, such as OpenWebUI, LM Studio or vLLM. This driver never calls the
# Responses API, so an endpoint with that disabled works here.
#
# The url is the api root and not the host. OpenWebUI serves its OpenAI-compatible
# endpoints under /api, so the value ends there - without it every prompt gets a 404.
#
# The model is required rather than optional. Hosted providers know their own model names
# and this one cannot, so leaving it empty fails with "requires a default text model".
# `php artisan ai:check` proves all three before anything else is worth debugging.
OPENAI_COMPATIBLE_URL=https://openwebui.example.com/api
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Optional. Looking a video up uses YouTube's keyless oEmbed endpoint, which answers
# almost every lookup on its own; a key here buys a second opinion from the Data API
# for the ones it does not, so a rate limited or unreachable oEmbed becomes "no such
# video" or a title instead of "we could not check". Left empty, that second opinion
# is simply never asked for and nothing else changes.
YOUTUBE_API_KEY=
